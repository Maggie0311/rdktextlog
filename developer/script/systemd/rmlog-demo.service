[Unit]
Description=RoboMaster rmlog business logger demo
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/rdk_x5_software/developer/script/rmlog/fault_demo.py /userdata/rmlog
Restart=on-failure
RestartSec=1
StartLimitIntervalSec=30
StartLimitBurst=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
