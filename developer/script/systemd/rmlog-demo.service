[Unit]
Description=RoboMaster rmlog business logger demo
After=local-fs.target

[Service]
Type=simple
WatchdogSec=2
ExecStart=/usr/bin/python3 -m rmlog.daemon /userdata/rmlog
WorkingDirectory=/opt/rdk_x5_software/developer/script
Restart=on-failure
RestartSec=1
StartLimitIntervalSec=30
StartLimitBurst=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
